{
  "name": "pseudoend-backend",
  "version": "1.0.0",
  "description": "High-throughput, zero-idle-cost serverless mock backend engine and management API",
  "main": "dist/handlers/mockEngine.js",
  "scripts": {
    "build": "node build.js",
    "build:tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "serverless",
    "aws-lambda",
    "mock-api",
    "ephemeral-backend",
    "dynamodb"
  ],
  "author": "Pseudoend core team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@faker-js/faker": "^8.4.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
